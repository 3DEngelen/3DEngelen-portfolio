---
import type { Project } from '../lib/projects';
import {
  imageUrl,
  projectExcerpt,
  projectImages,
  projectUrl,
} from '../lib/projects';

interface Props {
  project: Project;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const image = projectImages(project).card;
---

<article
  class:list={['project-card', { featured }]}
  data-tags={JSON.stringify(project.data.tags)}
>
  <a href={projectUrl(project)} aria-label={`View ${project.data.title}`}>
    <div class="card-image">
      <img
        src={imageUrl(image.src)}
        width={image.width}
        height={image.height}
        alt={image.alt}
        loading="lazy"
        decoding="async"
      />
      <span class="card-arrow" aria-hidden="true">
        ↗
      </span>
    </div>
    <div class="card-heading">
      <h3>{project.data.title}</h3>
      {project.data.completed && (
        <span class="year">{project.data.completed.slice(0, 4)}</span>
      )}
    </div>
    <p>{projectExcerpt(project)}</p>
    <div class="tags" aria-label="Project tags">
      {project.data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </a>
</article>
