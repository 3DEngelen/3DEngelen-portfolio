---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  allProjects,
  imageUrl,
  projectExcerpt,
  projectImages,
} from '../../lib/projects';

export async function getStaticPaths() {
  return (await allProjects()).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const images = projectImages(project);
const excerpt = projectExcerpt(project);
const social = project.data.seo?.image
  ? images.previews[project.data.seo.image.slice('pictures/'.length)]
  : images.hero;
---

<Layout
  title={project.data.seo?.title ?? project.data.title}
  description={project.data.seo?.description ?? excerpt}
  image={social.src}
  type="article"
>
  <article class="project-page section-shell">
    <a class="back-link" href={`${import.meta.env.BASE_URL}projects/`}>
      ← All projects
    </a>
    <header class="project-header">
      <p class="eyebrow">
        PROJECT
        {project.data.completed && ` / ${project.data.completed.slice(0, 4)}`}
      </p>
      <h1>
        {project.data.title}
        <span class="accent">.</span>
      </h1>
      <p class="project-deck">{project.data.description}</p>
      <div class="tags">
        {project.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>
    <figure class="project-hero">
      <img
        src={imageUrl(images.hero.src)}
        width={images.hero.width}
        height={images.hero.height}
        alt={images.hero.alt}
        fetchpriority="high"
      />
      {images.hero.caption && <figcaption>{images.hero.caption}</figcaption>}
    </figure>
    <div class="project-body">
      <div class="project-meta">
        <p class="eyebrow">PROJECT NOTES</p>
        {project.data.completed && (
          <p>
            Completed <strong>{project.data.completed.slice(0, 4)}</strong>
          </p>
        )}
        {project.data.printers.length > 0 && (
          <div class="project-details">
            <p class="eyebrow">PRINTERS</p>
            <ul>
              {project.data.printers.map((printer) => (
                <li>{printer}</li>
              ))}
            </ul>
          </div>
        )}
        {project.data.materials.length > 0 && (
          <div class="project-details">
            <p class="eyebrow">MATERIALS</p>
            <ul>
              {project.data.materials.map((material) => (
                <li>
                  {material.brand && `${material.brand} `}
                  {material.name}
                  {material.grade && ` / ${material.grade}`}
                </li>
              ))}
            </ul>
          </div>
        )}
        {project.data.resources.length > 0 && (
          <div class="resources">
            <p class="eyebrow">RESOURCES</p>
            <ul>
              {project.data.resources.map((resource) => (
                <li>
                  <span>{resource.type}</span>
                  <a
                    href={resource.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {resource.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
    {images.gallery.length > 1 && (
      <section class="gallery" aria-labelledby="gallery-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">A CLOSER LOOK</p>
            <h2 id="gallery-title">
              Gallery<span class="accent">.</span>
            </h2>
          </div>
        </div>
        <div class="gallery-grid">
          {images.gallery.map((image) => (
            <figure>
              <img
                src={imageUrl(image.src)}
                width={image.width}
                height={image.height}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
