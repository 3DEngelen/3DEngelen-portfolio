---
import Layout from '../layouts/Layout.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { allProjects, featuredProjects } from '../lib/projects';

const projects = await allProjects();
const featured = featuredProjects(projects);
---

<Layout
  title="Projects and practical making"
  description="Finished 3DEngelen maker projects, shared with fellow makers and technical peers."
>
  <section class="intro section-shell">
    <p class="eyebrow">
      <span class="status-dot"></span> 3DENGELEN / MAKER PORTFOLIO
    </p>
    <h1>
      Built with intent<span class="accent">.</span>
      <br />
      <span class="outline-text">Shared in detail.</span>
    </h1>
    <div class="intro-bottom">
      <p>
        A collection of finished projects: the ideas, the outcomes, and the
        useful details in between.
      </p>
      <a class="text-link" href="#listing-title">
        Explore the work <span aria-hidden="true">↘</span>
      </a>
    </div>
    <span class="intro-index" aria-hidden="true">
      01 / WORK
    </span>
  </section>
  <ProjectCarousel projects={featured} />
  <ProjectGrid projects={projects} />
</Layout>
