---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectHero from '../components/ProjectHero.astro';
import { allProjects, featuredProjects } from '../lib/projects';

const projects = await allProjects();
const featured = featuredProjects(projects);
const heroProjects = [
  ...featured,
  ...projects.filter((project) => !featured.includes(project)),
].slice(0, 5);
---

<Layout
  title="Projects and practical making"
  description="Finished 3DEngelen maker projects, shared with fellow makers and technical peers."
>
  <ProjectHero projects={heroProjects} />
  <ProjectGrid projects={projects} />
</Layout>
