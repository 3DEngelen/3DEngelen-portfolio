<Layout title="About and contact" description="About 3DEngelen and how to get in touch.">
  <div class="page-intro section-shell">
    <p class="eyebrow">THE PERSON BEHIND THE WORK</p>
    <h1>About<span class="accent">.</span></h1>
    <p>A space for making and sharing finished work.</p>
  </div>
  <section class="about-content section-shell">
    <div><p class="eyebrow">01 / BACKGROUND</p><h2>The maker</h2></div>
    <p><strong>[BIO PLACEHOLDER]</strong> Add your own short introduction here. Describe your interests and approach in your own words.</p>
    <div><p class="eyebrow">02 / GET IN TOUCH</p><h2>Contact</h2></div>
    <p><strong>[EMAIL PLACEHOLDER]</strong> Add your preferred contact email address here before publishing.</p>
  </section>
</Layout>
